# Copie ce fichier en ".env" puis adapte-le :  cp .env.example .env
# Le fichier .env n'est jamais envoyé sur git (voir .gitignore).

# --- Quel LLM utiliser ? -----------------------------------------------
# ollama : modèle local, rien ne quitte la machine (défaut)
# gemini : API Google, tier gratuit. UNIQUEMENT avec de faux CV.
# custom : une URL à toi (ex. Ollama lancé sur Colab pour une démo)
LLM_PROVIDER=ollama

# Garde-fou vie privée : gemini et custom refusent de démarrer tant que
# cette ligne ne vaut pas "true".
ALLOW_REMOTE=false

# --- Provider "ollama" --------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
# Taille de la fenêtre de contexte (en tokens). Trop petite = CV tronqué.
OLLAMA_NUM_CTX=8192
# Durée pendant laquelle Ollama garde le modèle en mémoire entre 2 CV.
OLLAMA_KEEP_ALIVE=30m

# --- Provider "gemini" --------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# --- Provider "custom" --------------------------------------------------
# CUSTOM_API_STYLE=openai  -> l'URL expose /chat/completions (ex. https://xxx/v1)
# CUSTOM_API_STYLE=ollama  -> l'URL est un serveur Ollama (ex. https://xxx.ngrok.app)
CUSTOM_API_STYLE=openai
CUSTOM_BASE_URL=
CUSTOM_MODEL=
CUSTOM_API_KEY=

# --- Réglages généraux --------------------------------------------------
# Temps maximum d'attente d'une réponse du LLM, en secondes (le CPU est lent).
LLM_TIMEOUT_S=900
# Nombre maximum de tokens que le modèle peut écrire pour un CV.
LLM_MAX_OUTPUT_TOKENS=2500
# Au-delà de cette longueur, le texte du CV est coupé avant l'envoi au LLM.
MAX_CV_CHARS=12000
# Langues de l'OCR, notées comme dans Tesseract (fra = français, eng = anglais).
# L'OCR de macOS comprend aussi cette notation.
OCR_LANGUAGES=fra+eng

# --- Apparence des documents --------------------------------------------
# Couleur principale (bandeau de la diapositive, titres du PDF) et couleur du
# fin trait sous le bandeau. Format : # suivi de 6 chiffres hexadécimaux.
THEME_ACCENT=#1F4E79
THEME_STRIPE=#E8A33D
# Un logo (PNG ou JPEG) affiché en haut à droite de la diapositive. Vide = pas de logo.
THEME_LOGO_PATH=
# Le texte du pied de page de la diapositive. Vide = « Profil candidat · Confidentiel ».
THEME_FOOTER=
# Le modèle PowerPoint (.pptx) de ton entreprise. S'il est indiqué, la fiche est
# dessinée par-dessus : le fond, le logo et le pied de page du modèle remplacent
# la barre de couleur, le logo et le pied de page ci-dessus.
THEME_TEMPLATE_PATH=

# --- Conservation et accès ----------------------------------------------
# Les lots plus vieux que ce nombre de jours sont supprimés automatiquement
# (les CV sont des données personnelles). 0 = ne jamais rien supprimer.
OUTPUT_RETENTION_DAYS=30
# Mot de passe demandé par le navigateur (le nom d'utilisateur est libre).
# Vide = pas de mot de passe : à réserver à un usage sur ta seule machine.
APP_PASSWORD=

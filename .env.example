# Copie ce fichier en ".env" puis adapte-le :  cp .env.example .env
# Le fichier .env n'est jamais envoyé sur git (voir .gitignore).

# --- Quel LLM utiliser ? -----------------------------------------------
# ollama : modèle local, rien ne quitte la machine (défaut)
# gemini : API Google, tier gratuit. UNIQUEMENT avec de faux CV.
# custom : une URL à toi (ex. Ollama lancé sur Colab pour une démo)
LLM_PROVIDER=ollama

# Garde-fou vie privée : gemini et custom refusent de démarrer tant que
# cette ligne ne vaut pas "true".
ALLOW_REMOTE=false

# --- Provider "ollama" --------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
# Taille de la fenêtre de contexte (en tokens). Trop petite = CV tronqué.
OLLAMA_NUM_CTX=8192
# Durée pendant laquelle Ollama garde le modèle en mémoire entre 2 CV.
OLLAMA_KEEP_ALIVE=30m

# --- Provider "gemini" --------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# --- Provider "custom" --------------------------------------------------
# CUSTOM_API_STYLE=openai  -> l'URL expose /chat/completions (ex. https://xxx/v1)
# CUSTOM_API_STYLE=ollama  -> l'URL est un serveur Ollama (ex. https://xxx.ngrok.app)
CUSTOM_API_STYLE=openai
CUSTOM_BASE_URL=
CUSTOM_MODEL=
CUSTOM_API_KEY=

# --- Réglages généraux --------------------------------------------------
# Temps maximum d'attente d'une réponse du LLM, en secondes (le CPU est lent).
LLM_TIMEOUT_S=900
# Nombre maximum de tokens que le modèle peut écrire pour un CV.
LLM_MAX_OUTPUT_TOKENS=2500
# Au-delà de cette longueur, le texte du CV est coupé avant l'envoi au LLM.
MAX_CV_CHARS=12000
# Langues de l'OCR Tesseract (fra = français, eng = anglais).
OCR_LANGUAGES=fra+eng
